+    fn set_agent_close_test_state(
+        state: &mut AppState,
+        pane_id: PaneId,
+        agent_state: AgentState,
+        seen: bool,
+        seq: u64,
+    ) {
+        transition_agent_state(state, pane_id, agent_state);
+        let tab_idx = state.workspaces[0]
+            .find_tab_index_for_pane(pane_id)
+            .expect("pane should belong to a tab");
+        let terminal_id = state.workspaces[0].tabs[tab_idx].panes[&pane_id]
+            .attached_terminal_id
+            .clone();
+        state
+            .terminals
+            .get_mut(&terminal_id)
+            .unwrap()
+            .last_agent_state_change_seq = Some(seq);
+        state.workspaces[0].tabs[tab_idx]
+            .panes
+            .get_mut(&pane_id)
+            .unwrap()
+            .seen = seen;
+    }
