+pub(super) enum AgentOwnerError {
+    Target(TerminalTargetError),
+    OwnerTarget(TerminalTargetError),
+    SelfOwned,
+    Cycle,
+    NotAgent { target: String },
+    OwnerNotAgent { target: String },
+}
