+            Rect::new(spaces.x + spaces.width - 4, spaces.y, 3, 1)
+        );
+        assert_eq!(
+            row_text(&buffer, spaces.y, area.width),
+            " spaces       +  │"
+        );
+        assert_eq!(
+            row_text(&buffer, spaces.y + spaces.height - 1, area.width),
+            "           menu  │"
+        );
+    }
