+    fn state_icons_config(pairs: &[(&str, &str)]) -> crate::config::AgentsSidebarConfig {
+        let mut config = crate::config::AgentsSidebarConfig::default();
+        for (key, glyph) in pairs {
+            config
+                .state_icons
+                .insert((*key).to_string(), (*glyph).to_string());
+        }
+        config
+    }
