+
+pub(crate) fn pane_copy_button_span(info: &PaneInfo) -> Option<(u16, u16, u16)> {
+    if !info.borders.contains(Borders::TOP) || info.rect.width < 8 {
+        return None;
+    }
+    let x_end = info
+        .rect
+        .x
+        .saturating_add(info.rect.width)
+        .saturating_sub(1);
+    Some((x_end.saturating_sub(3), x_end, info.rect.y))
 }
 
