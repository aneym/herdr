+pub(super) fn animated_state_icon(
+    state: AgentState,
+    seen: bool,
+    indicator_style: StatusIndicatorStyle,
+    tick: u32,
+    p: &Palette,
+) -> (&'static str, Style) {
+    if state == AgentState::Working {
+        (
+            super::spinner_frame(tick),
+            Style::default().fg(state_label_color(state, seen, p)),
+        )
+    } else {
+        state_icon(state, seen, indicator_style, p)
+    }
+}
+
+pub(super) fn resolved_agent_icon<'a>(
+    config: &'a crate::config::AgentsSidebarConfig,
+    state: AgentState,
+    seen: bool,
+    indicator_style: StatusIndicatorStyle,
+    tick: u32,
+    p: &Palette,
+) -> (&'a str, Style) {
+    let default_icon = animated_state_icon(state, seen, indicator_style, tick, p);
+    (
+        config.state_icon(state, seen).unwrap_or(default_icon.0),
+        default_icon.1,
+    )
+}
+
+/// Config-aware state glyph without the working-state spinner animation, for
+/// roll-up dots that stand in for panes rather than a live agent row.
+pub(super) fn resolved_state_dot<'a>(
+    config: &'a crate::config::AgentsSidebarConfig,
+    state: AgentState,
+    seen: bool,
+    indicator_style: StatusIndicatorStyle,
+    p: &Palette,
+) -> (&'a str, Style) {
+    let default_icon = state_icon(state, seen, indicator_style, p);
+    (
+        config.state_icon(state, seen).unwrap_or(default_icon.0),
+        default_icon.1,
+    )
+}
+
