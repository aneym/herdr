     #[test]
+    fn working_agent_icon_uses_v075_spinner_frames() {
+        let palette = Palette::catppuccin();
+        let frames = (0..10)
+            .map(|index| {
+                animated_state_icon(
+                    AgentState::Working,
+                    true,
+                    StatusIndicatorStyle::Dots,
+                    index * 8,
+                    &palette,
+                )
+                .0
+            })
+            .collect::<Vec<_>>();
+
+        assert_eq!(frames, ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"]);
+    }
