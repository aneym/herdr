    { "name": "tab right edge", "layout": "three", "source": "A", "point": [119.5, 20.5],
      "zone": { "kind": "tab_edge", "side": "right" }, "estimate": [80, 0, 40, 40] },
    { "name": "tab top edge", "layout": "three", "source": "A", "point": [90.5, 0.5],
      "zone": { "kind": "tab_edge", "side": "up" }, "estimate": [0, 0, 120, 13] },
    { "name": "tab bottom edge", "layout": "three", "source": "A", "point": [90.5, 39.5],
      "zone": { "kind": "tab_edge", "side": "down" }, "estimate": [0, 27, 120, 13] },
    { "name": "tab corner tie goes left", "layout": "three", "source": "A", "point": [0.5, 0.5],
      "zone": { "kind": "tab_edge", "side": "left" }, "estimate": [0, 0, 40, 40] },
    { "name": "one-pane tab has no tab edge; its own pane is the source", "layout": "lone", "source": "X", "point": [0.5, 20.5],
      "zone": null },
    { "name": "one-pane tab has no tab edge; a pane from another tab gets the pane edge", "layout": "lone", "source": null, "point": [0.5, 20.5],
      "zone": { "kind": "pane_edge", "target": "X", "side": "left" }, "estimate": [0, 0, 60, 40] },
    { "name": "gap cell belongs to the nearest pane", "layout": "gaps", "source": "G3", "point": [60.3, 10.5],
      "zone": { "kind": "pane_edge", "target": "G1", "side": "right" }, "estimate": [30, 0, 30, 40] },
    { "name": "gap cell tie goes to the earlier pane", "layout": "gaps", "source": "G3", "point": [90.5, 20.5],
      "zone": { "kind": "pane_edge", "target": "G2", "side": "down" }, "estimate": [61, 10, 59, 10] },
    { "name": "right of the area has no zone", "layout": "three", "source": "A", "point": [130.5, 20.5],
      "zone": null },
    { "name": "left of the area has no zone", "layout": "three", "source": "A", "point": [-0.5, 20.5],
      "zone": null }
  ]
}
