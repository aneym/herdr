#!/usr/bin/env python3
"""Attach and read one agent's context file.

  herdr-context add <url|path> [--title T] [--tab TAB]
  herdr-context list [--json] [--tab TAB]
  herdr-context rm <id> [--tab TAB]
  herdr-context show [--tab TAB]

The tab is --tab, or HERDR_PANE_ID. An agent target uses `herdr agent get`.
A pane id that is not an agent is resolved with `herdr pane get`.
The file is $HERDR_CONTEXT_DIR/<tab id with : as _>.json
(default ~/.agent-rails/herdr/context).
"""
import json
import os
import subprocess
import sys
import tempfile
from datetime import datetime, timezone
from urllib.parse import parse_qs, urlparse


def die(msg, code=2):
    print(f"herdr-context: {msg}", file=sys.stderr)
    raise SystemExit(code)


def directory():
    home = os.environ.get("HOME") or os.path.expanduser("~")
    return os.environ.get("HERDR_CONTEXT_DIR") or os.path.join(home, ".agent-rails", "herdr", "context")


def path_for(tab):
    return os.path.join(directory(), tab.replace(":", "_") + ".json")


def load(tab):
    p = path_for(tab)
    if not os.path.exists(p):
        return {"version": 1, "tab": tab, "items": []}
    with open(p) as f:
        doc = json.load(f)
    doc.setdefault("items", [])
    doc["tab"] = tab
    doc["version"] = 1
    return doc


def save(tab, doc):
    dest = path_for(tab)
    os.makedirs(os.path.dirname(dest), exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(dest), suffix=".tmp")
    try:
        with os.fdopen(fd, "w") as f:
            json.dump(doc, f, indent=2, sort_keys=True)
            f.write("\n")
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, dest)
    except Exception:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def herdr_cmd(*args):
    cmd = [os.environ.get("HERDR_BIN") or "herdr"]
    session = os.environ.get("HERDR_SESSION") or os.environ.get("SHELL_LAB")
    if session:
        cmd += ["--session", session]
    cmd += list(args)
    return subprocess.run(cmd, capture_output=True, text=True)


def first_tab_id(stdout):
    try:
        data = json.loads(stdout)
    except json.JSONDecodeError:
        return None
    found = []

    def walk(node):
        if isinstance(node, dict):
            if isinstance(node.get("tab_id"), str):
                found.append(node["tab_id"])
            for v in node.values():
                walk(v)
        elif isinstance(node, list):
            for v in node:
                walk(v)

    walk(data)
    return found[0] if found else None


def tab_from_pane(pane):
    """A pane id is not an agent target. `agent get` returns agent_not_found
    for a plain shell pane; `pane get` has that pane's tab_id."""
    agent = herdr_cmd("agent", "get", pane)
    if agent.returncode == 0:
        tab = first_tab_id(agent.stdout)
        if tab:
            return tab
    pane_res = herdr_cmd("pane", "get", pane)
    if pane_res.returncode == 0:
        tab = first_tab_id(pane_res.stdout)
        if tab:
            return tab
        die(f"herdr pane get {pane} had no tab_id")
    detail = (agent.stderr or agent.stdout or pane_res.stderr or pane_res.stdout).strip()
    die(f"could not resolve pane {pane}: {detail}")


def resolve_tab(args):
    if "--tab" in args:
        i = args.index("--tab")
        if i + 1 >= len(args):
            die("--tab needs a tab id")
        return args[i + 1], [a for n, a in enumerate(args) if n not in (i, i + 1)]
    pane = os.environ.get("HERDR_PANE_ID")
    if not pane:
        die("no tab: pass --tab or set HERDR_PANE_ID")
    return tab_from_pane(pane), args


def flag(args, name):
    if name not in args:
        return None, args
    i = args.index(name)
    if i + 1 >= len(args):
        die(f"{name} needs a value")
    return args[i + 1], [a for n, a in enumerate(args) if n not in (i, i + 1)]


def next_id(items):
    n = 0
    for item in items:
        raw = str(item.get("id", ""))
        if raw.startswith("c") and raw[1:].isdigit():
            n = max(n, int(raw[1:]))
    return f"c{n + 1}"


def derived(tab):
    home = os.environ.get("HOME") or os.path.expanduser("~")
    lanes_path = os.environ.get("HERDR_LANES_PATH") or os.path.join(home, ".agent-rails", "herdr", "lanes.json")
    if not os.path.exists(lanes_path):
        return []
    with open(lanes_path) as f:
        lanes = json.load(f)
    lane = next((l for l in lanes.get("lanes", []) if l.get("tab") == tab), None)
    if not lane:
        return []
    out = []
    if lane.get("scope_url"):
        out.append("Scope")
    if lane.get("review_url"):
        out.append("Review")
    folder = None
    scope = lane.get("scope_url") or ""
    route = parse_qs(urlparse(scope).query).get("route", [""])[0]
    bits = route.split("/")
    if len(bits) >= 2 and bits[0] == "scoping" and bits[1]:
        folder = os.path.join(home, ".agent-rails", "scoping", bits[1])
    else:
        name = (lane.get("name") or "").removeprefix("[scoping] ").replace(" ", "-")
        candidate = os.path.join(home, ".agent-rails", "lanes", name) if name else ""
        if candidate and os.path.isdir(candidate):
            folder = candidate
    if folder:
        for file in ("RESUME", "BRIEF", "DECISIONS"):
            if os.path.exists(os.path.join(folder, file + ".md")):
                out.append(file)
    return out


def main(argv):
    if len(argv) < 2 or argv[1] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    cmd, rest = argv[1], argv[2:]
    if cmd == "add":
        tab, rest = resolve_tab(rest)
        title, rest = flag(rest, "--title")
        if len(rest) != 1:
            die("add needs one url or path")
        ref = rest[0]
        if ref.startswith("http://") or ref.startswith("https://"):
            kind = "url"
            title = title or ref
        else:
            kind = "file"
            ref = os.path.abspath(ref)
            title = title or os.path.basename(ref)
        doc = load(tab)
        doc["items"].append({
            "id": next_id(doc["items"]),
            "kind": kind,
            "title": title,
            "ref": ref,
            "added_by": "agent",
            "added_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        })
        save(tab, doc)
        print(doc["items"][-1]["id"])
        return 0
    if cmd == "list":
        tab, rest = resolve_tab(rest)
        as_json = "--json" in rest
        doc = load(tab)
        if as_json:
            print(json.dumps(doc["items"]))
        else:
            for item in doc["items"]:
                print(f"{item['id']}\t{item['kind']}\t{item['title']}\t{item['ref']}")
        return 0
    if cmd == "rm":
        tab, rest = resolve_tab(rest)
        if len(rest) != 1:
            die("rm needs an item id")
        doc = load(tab)
        doc["items"] = [i for i in doc["items"] if i.get("id") != rest[0]]
        save(tab, doc)
        return 0
    if cmd == "show":
        tab, _rest = resolve_tab(rest)
        for name in derived(tab):
            print(name)
        for item in load(tab)["items"]:
            print(item["title"])
        return 0
    die(f"unknown command {cmd}")


if __name__ == "__main__":
    sys.exit(main(sys.argv))
